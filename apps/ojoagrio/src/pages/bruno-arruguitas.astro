---
// Página oficial de Bruno Arruguitas (@bruno.arruguitas), el pug chilango.
// La esencia (voz de El Nero, caló chilango blanco, "Equipo Arruguitas") sale
// de D:\proyectos\bruno\CLAUDE.md — mantener el tono alineado con los videos.
// Assets en /public/bruno-arruguitas (fotos redimensionadas desde ese proyecto).

const TIKTOK = 'https://www.tiktok.com/@bruno.arruguitas';
const EMAIL = 'ojoagrio@gmail.com';
const MAILTO = `mailto:${EMAIL}?subject=${encodeURIComponent('Colaboración con Bruno Arruguitas 🐾')}`;

// Pedidos de saludos: el formulario arma el mensaje y abre WhatsApp con él.
const WHATSAPP = '5214464796315';

// Precios en MXN (sugeridos para una cuenta de ~12K; subirlos conforme crezca).
// precio: null muestra "Cotiza por WhatsApp"; desde: true antepone "Desde".
const saludos = [
  { id: 'cumple', emoji: '🎂', titulo: 'Saludo de cumpleaños', desc: 'Bruno le canta las mañanitas a su manera.', precio: 149 as number | null, desde: false },
  { id: 'dedicatoria', emoji: '💌', titulo: 'Dedicatoria', desc: 'Para tu crush, tu jefa o tu compa. Con todo el flow.', precio: 149 as number | null, desde: false },
  { id: 'chatito', emoji: '🐶', titulo: 'Saludo para tu chatito', desc: 'De pug a pug, con la foto de tu perrito. Tu chatito también merece fama.', precio: 199 as number | null, desde: false },
  { id: 'otro', emoji: '✨', titulo: 'Otra ocasión', desc: 'Graduación, aniversario, ánimo… tú dime, pariente.', precio: 199 as number | null, desde: true },
];
const precioTxt = (s: { precio: number | null; desde: boolean }) =>
  s.precio == null ? 'Cotiza por WhatsApp' : `${s.desde ? 'Desde ' : ''}$${s.precio} MXN`;
const BASE = '/bruno-arruguitas';

// Actualizar a mano cuando la cuenta crezca.
const SEGUIDORES = 12_000;
const META = 100_000;
const seguidoresTxt = `${Math.floor(SEGUIDORES / 1000)}K`;
const avance = Math.max(3, Math.round((SEGUIDORES / META) * 100));

const title = 'Bruno Arruguitas — el jefe del barrio 🐾';
const description =
  'Página oficial de Bruno Arruguitas, el pug chilango de TikTok. Paseos, chismes de chatitos y pide tu saludo personalizado de Bruno. ¡Ira nomás!';
const ogImage = new URL(`${BASE}/og.jpg`, Astro.site).toString();

const ficha = [
  { k: 'Raza', v: 'Pug chato, cien por ciento barrio' },
  { k: 'Arrugas', v: '47 (y contando)' },
  { k: 'Outfit', v: 'Suéter de abuelito a cuadros' },
  { k: 'Superpoder', v: 'Cobrar la pata en apapachos' },
  { k: 'Lugar favorito', v: 'El Kiosco Morisco, jefazo' },
  { k: 'Sueldo', v: 'Pago en croquetas' },
];

const fotos = [
  { src: 'p1.jpg', alt: 'Bruno sentado con su suéter a cuadros', pos: '50% 30%' },
  { src: 'real1.jpg', alt: 'Bruno con pechera frente a un mural', pos: '50% 70%' },
  { src: 'p2.jpg', alt: 'Bruno con suéter de vaquita mirando a la cámara', pos: '50% 20%' },
  { src: 'p8.jpg', alt: 'Bruno con suéter de rayas en la cama', pos: '50% 40%' },
  { src: 'p5.jpg', alt: 'Bruno panza arriba pidiendo apapachos', pos: '50% 40%' },
  { src: 'p7.jpg', alt: 'Bruno echado como alfombra en la cama', pos: '50% 50%' },
  { src: 'p10.jpg', alt: 'Bruno con suéter naranja junto a unos muñequitos', pos: '50% 40%' },
  { src: 'p4.jpg', alt: 'Bruno posando muy serio', pos: '50% 40%' },
  { src: 'p9.jpg', alt: 'Bruno tomando el sol en el patio', pos: '30% 60%' },
];

const videos = [
  { emoji: '🚶', titulo: 'Tutorial: cómo pasear a Bruno', tag: 'El clásico' },
  { emoji: '🏛️', titulo: 'El paseo sorpresa al Kiosco Morisco', tag: 'Batería al 1%' },
  { emoji: '🐾', titulo: 'POV: tu humano quiere que des la pata', tag: 'Diva certificado' },
  { emoji: '🧳', titulo: 'La maleta secreta', tag: 'Muñequitos 347 vs Bruno 1' },
  { emoji: '👵', titulo: 'Anatomía del pug con ciencia de abuela', tag: 'Con Doña Chela' },
  { emoji: '👑', titulo: '5 cosas que no sabías de los chatitos', tag: 'La última sorprende' },
];

const equipo = [
  { nombre: 'Toby', src: 'toby.jpg' },
  { nombre: 'Tuna', src: 'tuna.jpg' },
  { nombre: 'Coco', src: 'coco.jpg' },
  { nombre: 'Bruno (el otro)', src: 'bruno.jpg' },
  { nombre: 'Dogy', src: 'dogy.jpg' },
  { nombre: 'Misu', src: 'misu.jpg' },
];

const consejos = [
  { emoji: '☀️', t: 'Nada de calorón', d: 'Los chatos sufren con el calor: paseo temprano, sombrita y agua siempre.' },
  { emoji: '🧽', t: 'Arrugas limpias', d: 'Límpialas y sécalas bien. Arruga húmeda, arruga enojada.' },
  { emoji: '👃', t: 'Déjame olfatear', d: 'Oler el barrio es mi periódico, pariente. No me apures.' },
  { emoji: '♻️', t: 'Recoge lo de tu perrito', d: 'Misión cumplida no es misión terminada. Bolsita siempre.' },
];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2b2420" />
    <link rel="icon" type="image/jpeg" href={`${BASE}/cara.jpg`} />
    <link rel="canonical" href={new URL(BASE, Astro.site).toString()} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bungee&family=Baloo+2:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="sueter" aria-hidden="true"></div>

    <main>
      <!-- HERO -->
      <header class="hero">
        <div class="avatar-wrap">
          <img class="avatar" src={`${BASE}/cara.jpg`} alt="Cara de Bruno Arruguitas" width="512" height="512" />
          <span class="badge-check" title="Pug verificado">✓</span>
        </div>
        <p class="kicker">¡Ira nomás!</p>
        <h1 class="display">Bruno<br /><span>Arruguitas</span></h1>
        <p class="tagline">El jefe del barrio 🐾 Pug chilango, modelo de tiempo completo y crítico de croquetas.</p>

        <a class="cta" href={TIKTOK} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M14 3c.4 2.2 1.9 3.7 4.2 3.9v2.6c-1.5 0-2.9-.4-4.2-1.3v6.1c0 3.1-2.3 5.4-5.3 5.4-3 0-5.3-2.3-5.3-5.4S5.7 9 8.7 9c.4 0 .8 0 1.1.1v2.7c-.3-.1-.7-.2-1.1-.2-1.6 0-2.8 1.2-2.8 2.8s1.2 2.8 2.8 2.8 2.9-1.2 2.9-2.8V3h2.4z" />
          </svg>
          <span>
            Sígueme en TikTok
            <small>@bruno.arruguitas</small>
          </span>
        </a>

        <a class="cta-saludo" href="#saludos">
          <span aria-hidden="true">🎥</span>
          <span>
            Pide tu saludo de Bruno
            <small>Video personalizado · desde $149 MXN</small>
          </span>
        </a>

        <button class="jingle" type="button" id="jingle-btn" aria-pressed="false">
          <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="jingle-txt">Dale play a mi canción</span>
        </button>
        <audio id="jingle" src={`${BASE}/jingle.mp3`} preload="none"></audio>
      </header>

      <!-- META -->
      <section class="card meta">
        <div class="meta-row">
          <strong class="display">{seguidoresTxt}+</strong>
          <span>en el Equipo Arruguitas</span>
        </div>
        <div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax={META} aria-valuenow={SEGUIDORES} aria-label="Rumbo a 100 mil seguidores">
          <div class="bar-fill" style={`width:${avance}%`}></div>
        </div>
        <p class="meta-foot">Rumbo a los <b>100K</b>, pariente. ¿Me echas la mano? 🐶</p>
      </section>

      <!-- FICHA -->
      <section>
        <h2 class="display">📋 Ficha técnica</h2>
        <dl class="ficha card">
          {ficha.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- GALERÍA -->
      <section>
        <h2 class="display">📸 Puras fotos de modelo</h2>
        <div class="galeria">
          {fotos.map((f, i) => (
            <figure class={i === 1 ? 'grande' : ''}>
              <img src={`${BASE}/fotos/${f.src}`} alt={f.alt} loading="lazy" decoding="async" style={`object-position:${f.pos}`} />
            </figure>
          ))}
        </div>
      </section>

      <!-- VIDEOS -->
      <section>
        <h2 class="display">🎬 Lo más visto</h2>
        <ul class="videos">
          {videos.map((v) => (
            <li>
              <a href={TIKTOK} target="_blank" rel="noopener noreferrer">
                <span class="v-emoji" aria-hidden="true">{v.emoji}</span>
                <span class="v-txt">
                  {v.titulo}
                  <small>{v.tag}</small>
                </span>
                <span class="v-play" aria-hidden="true">▶</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- EQUIPO -->
      <section>
        <h2 class="display">🐶 Equipo Arruguitas</h2>
        <p class="sub">Los chatitos de la comunidad que ya salieron en la canción.</p>
        <div class="equipo">
          {equipo.map((p) => (
            <figure>
              <img src={`${BASE}/equipo/${p.src}`} alt={`${p.nombre}, del Equipo Arruguitas`} loading="lazy" />
              <figcaption>{p.nombre}</figcaption>
            </figure>
          ))}
        </div>
        <a class="card invita" href={TIKTOK} target="_blank" rel="noopener noreferrer">
          <b>¿Tu chatito aquí?</b> Comenta en mis videos con su nombre y foto. ¿Cómo ves? 👇
        </a>
      </section>

      <!-- CONSEJOS -->
      <section>
        <h2 class="display">💡 Consejos de chato a humano</h2>
        <div class="consejos">
          {consejos.map((c) => (
            <div class="card consejo">
              <span class="c-emoji" aria-hidden="true">{c.emoji}</span>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- SALUDOS -->
      <section id="saludos">
        <h2 class="display">🎥 Saludos de Bruno</h2>
        <p class="sub">Un video personalizado del jefe del barrio para quien tú quieras. Entrega en 2 a 3 días. ⏱️</p>

        <div class="saludos">
          {saludos.map((s) => (
            <div class="card saludo">
              <span class="c-emoji" aria-hidden="true">{s.emoji}</span>
              <h3>{s.titulo}</h3>
              <p>{s.desc}</p>
              <span class="precio">{precioTxt(s)}</span>
            </div>
          ))}
        </div>

        <ol class="pasos">
          <li><b>Llena tus datos</b> aquí abajo</li>
          <li><b>Se abre WhatsApp</b> con tu pedido listo, solo dale enviar</li>
          <li><b>Te mandamos el link de pago</b> y recibes tu video en <b>2 a 3 días</b></li>
        </ol>

        <form class="card pedido" id="pedido" data-wa={WHATSAPP}>
          <label>
            Tipo de saludo
            <select name="tipo" required>
              {saludos.map((s) => (
                <option value={`${s.titulo} (${precioTxt(s)})`}>{s.emoji} {s.titulo} · {precioTxt(s)}</option>
              ))}
            </select>
          </label>
          <label>
            ¿Para quién es?
            <input name="para" type="text" required maxlength="60" placeholder="Nombre de quien lo recibe" autocomplete="off" />
          </label>
          <label>
            ¿De parte de quién?
            <input name="de" type="text" required maxlength="60" placeholder="Tu nombre" autocomplete="name" />
          </label>
          <label>
            ¿Para cuándo lo necesitas?
            <input name="fecha" type="date" />
          </label>
          <label>
            Cuéntale a Bruno
            <textarea name="detalles" rows="3" maxlength="400" placeholder="La ocasión, un apodo, un dato chistoso, qué quieres que diga…"></textarea>
          </label>
          <button type="submit" class="wa-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z" />
            </svg>
            Pedir mi saludo por WhatsApp
          </button>
          <p class="nota">Tus datos solo viajan en el mensaje de WhatsApp. No guardamos nada.</p>
        </form>
      </section>

      <!-- COLABORACIONES -->
      <section>
        <h2 class="display">🤝 Colaboraciones</h2>
        <div class="card collab">
          <p>
            ¿Marca pet-friendly, evento, producto para chatitos o collab con otro perrito influencer?
            <b>El jefe del barrio está abierto a negociar</b> (acepta pago en croquetas, pero también en serio 😎).
          </p>
          <a class="collab-btn" href={MAILTO}>
            <span aria-hidden="true">✉️</span>
            <span>
              Escríbenos
              <small>{EMAIL}</small>
            </span>
          </a>
        </div>
      </section>

      <footer>
        <a class="cta cta-sm" href={TIKTOK} target="_blank" rel="noopener noreferrer">Seguir a Bruno →</a>
        <p class="display adios">Ahí nos vidrios 🐾</p>
        <p class="credito">Una producción de <a href="/">OjoAgrio</a> · © {new Date().getFullYear()}</p>
      </footer>
    </main>

    <script is:inline>
      (function () {
        var btn = document.getElementById('jingle-btn');
        var audio = document.getElementById('jingle');
        var txt = btn.querySelector('.jingle-txt');
        function set(playing) {
          btn.classList.toggle('playing', playing);
          btn.setAttribute('aria-pressed', playing ? 'true' : 'false');
          txt.textContent = playing ? 'Bruuuno… ¡Arruguitas! 🎶' : 'Dale play a mi canción';
        }
        btn.addEventListener('click', function () {
          if (audio.paused) {
            audio.play().then(function () { set(true); }).catch(function () { set(false); });
          } else {
            audio.pause();
            set(false);
          }
        });
        audio.addEventListener('ended', function () { set(false); });

        // Pedido de saludo → mensaje prellenado en WhatsApp.
        var form = document.getElementById('pedido');
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var d = new FormData(form);
          var v = function (k) { return String(d.get(k) || '').trim(); };
          var fecha = v('fecha');
          if (fecha) {
            var p = fecha.split('-');
            fecha = p[2] + '/' + p[1] + '/' + p[0];
          }
          var lineas = [
            '¡Quiubo! Quiero un saludo de Bruno Arruguitas 🐾',
            '',
            '🎥 Tipo: ' + v('tipo'),
            '🎯 Para: ' + v('para'),
            '🙋 De parte de: ' + v('de'),
          ];
          if (fecha) lineas.push('📅 Para el: ' + fecha);
          if (v('detalles')) lineas.push('📝 Detalles: ' + v('detalles'));
          var url = 'https://wa.me/' + form.dataset.wa + '?text=' + encodeURIComponent(lineas.join('\n'));
          window.open(url, '_blank', 'noopener');
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --arena: #e9c999;
    --arena-claro: #f6e6cc;
    --crema: #fff8ee;
    --mascara: #2b2420;
    --gris: #7d7f86;
    --gris-claro: #b9bbc1;
    --rosa: #ff7a9a;
    --tiktok: #111;
    --sombra: 0 4px 0 var(--mascara);
  }

  * { box-sizing: border-box; }

  html, body { margin: 0; padding: 0; }

  body {
    min-height: 100vh;
    background: var(--arena-claro);
    color: var(--mascara);
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.45;
    overflow-x: hidden;
  }
</style>

<style>
  /* Fondo: el suéter gris a cuadros de Bruno */
  .sueter {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-color: var(--arena-claro);
    background-image:
      repeating-linear-gradient(0deg, rgba(125, 127, 134, 0.13) 0 14px, transparent 14px 44px),
      repeating-linear-gradient(90deg, rgba(125, 127, 134, 0.13) 0 14px, transparent 14px 44px),
      repeating-linear-gradient(0deg, rgba(43, 36, 32, 0.06) 0 2px, transparent 2px 22px),
      repeating-linear-gradient(90deg, rgba(43, 36, 32, 0.06) 0 2px, transparent 2px 22px);
  }

  main {
    max-width: 560px;
    margin: 0 auto;
    padding: 28px 16px 48px;
  }

  .display {
    font-family: 'Bungee', 'Baloo 2', sans-serif;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  section { margin-top: 40px; }

  h2 {
    font-size: 1.25rem;
    margin: 0 0 14px;
  }

  .sub { margin: -8px 0 14px; color: #5c514a; }

  .card {
    background: var(--crema);
    border: 3px solid var(--mascara);
    border-radius: 20px;
    box-shadow: var(--sombra);
  }

  /* HERO */
  .hero { text-align: center; }

  .avatar-wrap {
    position: relative;
    width: 156px;
    height: 156px;
    margin: 8px auto 14px;
    animation: boing 2.6s ease-in-out infinite;
  }

  .avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 5px solid var(--mascara);
    box-shadow: 0 6px 0 var(--mascara);
    background: var(--arena);
  }

  .badge-check {
    position: absolute;
    right: 4px;
    bottom: 8px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #20d5ec;
    color: #fff;
    font-weight: 800;
    font-size: 1.1rem;
    border: 3px solid var(--mascara);
  }

  @keyframes boing {
    0%, 100% { transform: translateY(0) rotate(0); }
    50% { transform: translateY(-6px) rotate(-3deg); }
  }

  .kicker {
    display: inline-block;
    margin: 0 0 6px;
    padding: 2px 14px;
    background: var(--rosa);
    color: #fff;
    border: 3px solid var(--mascara);
    border-radius: 999px;
    font-weight: 800;
    transform: rotate(-3deg);
  }

  h1 {
    margin: 4px 0 10px;
    font-size: clamp(2.4rem, 12vw, 3.5rem);
    line-height: 0.95;
    color: var(--mascara);
  }

  h1 span {
    color: var(--arena);
    -webkit-text-stroke: 2px var(--mascara);
    text-shadow: 3px 3px 0 var(--mascara);
  }

  .tagline {
    margin: 0 auto 22px;
    max-width: 30ch;
    font-size: 1.08rem;
    font-weight: 600;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    padding: 14px 18px;
    background: var(--tiktok);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.1;
    border: 3px solid var(--mascara);
    border-radius: 18px;
    box-shadow: 4px 4px 0 #fe2c55, -4px -4px 0 #25f4ee;
    transition: transform 0.15s ease;
  }

  .cta:hover, .cta:focus-visible { transform: translateY(-2px) rotate(-1deg); }

  .cta svg { width: 30px; height: 30px; flex: none; }

  .cta span { display: flex; flex-direction: column; text-align: left; }

  .cta small { font-weight: 600; font-size: 0.85rem; opacity: 0.8; }

  .cta-saludo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    margin-top: 14px;
    padding: 12px 18px;
    background: var(--rosa);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1.1;
    border: 3px solid var(--mascara);
    border-radius: 18px;
    box-shadow: var(--sombra);
    transition: transform 0.15s ease;
  }

  .cta-saludo:hover, .cta-saludo:focus-visible { transform: translateY(-2px) rotate(1deg); }

